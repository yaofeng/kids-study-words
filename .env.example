# Copy to .env and adjust. Never commit real keys.

# Port published on the host.
PORT=8080

# Timezone used for "today" grouping and date display.
TZ=Asia/Shanghai

# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false

# Optional OpenAI-compatible example-sentence service.
# The API key is only read by the server; it is never logged or rendered.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
